# Copiar a .dev.vars para desarrollo local (npm run dev).
# Nunca subir el archivo con valores reales al repositorio.
# En .dev.vars NO poner comentarios al final de la misma línea.

# Supabase (proyecto de prueba para desarrollo)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Pública: puede estar en el frontend, RLS limita lo que expone
SUPABASE_ANON_KEY=
# SECRETA: solo servidor (Cloudflare). Nunca en el frontend
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago: dejar vacío hasta que se conecte. Cuando se conecte, usar credenciales de PRUEBA
# SECRETA
MP_ACCESS_TOKEN=
# SECRETA: para verificar la firma x-signature de los webhooks
MP_WEBHOOK_SECRET=

# URL del sitio (en local: http://localhost:8788)
PUBLIC_SITE_URL=http://localhost:8788
